PORT=3000

# Email where new quote requests are sent
ADMIN_EMAIL=manishscaleindia@gmail.com

# Secret key for admin dashboard (choose a long random string)
ADMIN_API_KEY=change-this-to-a-strong-secret

# SMTP — Gmail: use an App Password (Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=manishscaleindia@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Manish Scale <manishscaleindia@gmail.com>"
COMPANY_NAME=Manish Scale

# Frontend URLs allowed to call the API (comma-separated for production)
CORS_ORIGINS=http://localhost:5173,https://your-site.vercel.app
